{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(.+\\/.*)\\.js$": "$1"
  },
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true }]
  }
}
